# Copia este archivo como .env (ignorado por git) y completa los valores.

# Base de datos MySQL
PICUR_DB_USER=root
PICUR_DB_PASSWORD=

# Correo saliente (Gmail app password)
PICUR_MAIL_USER=
PICUR_MAIL_PASSWORD=
PICUR_MAIL_FROM=

# Web Push (genera un par VAPID propio; no reutilices el de otro proyecto)
PICUR_VAPID_PUBLIC_KEY=
PICUR_VAPID_PRIVATE_KEY=
PICUR_VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Origenes permitidos (PWA en Cloudflare Pages + dashboard local)
PICUR_CORS_ORIGINS=http://localhost:4321,https://tu-proyecto.pages.dev
PICUR_WS_ORIGINS=http://localhost:4321,https://tu-proyecto.pages.dev
